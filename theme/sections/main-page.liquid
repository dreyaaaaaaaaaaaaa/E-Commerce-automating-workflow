{%- comment -%}
  sections/main-page.liquid : page de contenu (À propos, CGV, mentions
  légales, livraison…). Colonne de lecture étroite, typographie éditoriale.
{%- endcomment -%}

<article class="enveloppe page-contenu" data-section="{{ section.id }}">
  <header class="page-contenu__entete">
    {%- if page.metafields.custom.surtitre.value != blank -%}
      <p class="mono">{{ page.metafields.custom.surtitre.value | escape }}</p>
    {%- endif -%}
    <h1 class="titre-1">{{ page.title }}</h1>
  </header>

  <div class="page-contenu__rte">{{ page.content }}</div>
</article>

{% stylesheet %}
  .page-contenu { padding-block: clamp(48px, 5.4vw, 78px) clamp(56px, 6vw, 92px); max-width: 78ch; }
  .page-contenu__entete { display: flex; flex-direction: column; gap: var(--e-2); margin-bottom: var(--e-8); }
  .page-contenu__rte { font-weight: 300; line-height: var(--lh-corps-l); color: var(--texte-doux); }
  .page-contenu__rte > * + * { margin-top: var(--e-5); }
  .page-contenu__rte h2 { font-family: var(--f-serif); font-size: var(--t-h4); color: var(--texte); margin-top: var(--e-9); }
  .page-contenu__rte h3 { font: 400 11px var(--f-sans); letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--texte); margin-top: var(--e-7); }
  .page-contenu__rte a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .page-contenu__rte ul { list-style: none; }
  .page-contenu__rte li { position: relative; padding-left: var(--e-5); }
  .page-contenu__rte li::before { content: '-'; position: absolute; left: 0; color: var(--texte-tenu); }
{% endstylesheet %}

{% schema %}
{ "name": "Page" }
{% endschema %}
