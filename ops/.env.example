# Copier en `.env` (non versionné) pour travailler en local.
# En CI ces valeurs viennent des secrets et variables d'environnement GitHub.

# Domaine technique de la boutique, toujours en .myshopify.com
SHOPIFY_SHOP=maison-dev.myshopify.com

# Jeton d'une app personnalisée (Paramètres → Apps → Développer des apps).
# Scopes stricts, rien de plus :
#   read_products, write_products
#   read_files, write_files
#   read_translations, write_translations
#   read_publications, write_publications
# Ne PAS accorder : read_customers, read_orders, write_orders, read_all_orders.
# Ce pipeline n'a aucune raison de voir un client ou une commande, et un
# jeton qui ne peut pas les lire ne peut pas les fuiter.
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Version d'API épinglée. À relever une fois par trimestre, en lisant le
# changelog : une version non épinglée casse le pipeline sans prévenir.
SHOPIFY_API_VERSION=2025-07
